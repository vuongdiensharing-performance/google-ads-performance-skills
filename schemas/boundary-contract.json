{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule-boundary-contract/v1",
  "title": "Rule Boundary Contract",
  "type": "object",
  "required": ["boundary_contract", "resolution_precedence"],
  "properties": {
    "boundary_contract": { "$ref": "#/$defs/ruleBoundaryContract" },
    "resolution_precedence": {
      "type": "array",
      "const": [
        "NOT_APPLICABLE",
        "APPLICABLE_MISSING_EVIDENCE",
        "CONFLICTING_EVIDENCE",
        "EXPLICIT_EXCLUSION",
        "APPLICABLE_TRIGGERED",
        "APPLICABLE_VALID"
      ]
    }
  },
  "$defs": {
    "ruleBoundaryContract": {
      "type": "object",
      "required": [
        "version",
        "applicable_when",
        "evidence_required",
        "states",
        "conflict_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0.0" },
        "applicable_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object", "minProperties": 1 }
            ]
          }
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "states": {
          "type": "object",
          "required": ["A", "B", "C", "D", "E", "F"],
          "additionalProperties": false,
          "properties": {
            "A": { "$ref": "#/$defs/state" },
            "B": { "$ref": "#/$defs/state" },
            "C": { "$ref": "#/$defs/state" },
            "D": { "$ref": "#/$defs/state" },
            "E": { "$ref": "#/$defs/state" },
            "F": { "$ref": "#/$defs/state" }
          }
        },
        "conflict_policy": { "$ref": "#/$defs/conflictPolicy" }
      }
    },
    "state": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "APPLICABLE_VALID",
            "APPLICABLE_TRIGGERED",
            "APPLICABLE_MISSING_EVIDENCE",
            "NOT_APPLICABLE",
            "CONFLICTING_EVIDENCE",
            "EXPLICIT_EXCLUSION"
          ]
        }
      }
    },
    "conflictPolicy": {
      "type": "object",
      "required": ["enabled", "when", "resolution"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "const": true },
        "when": {
          "type": "object",
          "minProperties": 1
        },
        "resolution": {
          "type": "object",
          "required": ["state", "decision", "inference_used"],
          "additionalProperties": false,
          "properties": {
            "state": { "const": "CONFLICTING_EVIDENCE" },
            "decision": {
              "enum": [
                "FAIL",
                "PASS",
                "SUPPRESSED",
                "NOT_APPLICABLE",
                "INSUFFICIENT_EVIDENCE",
                "POLICY_DEFINED"
              ]
            },
            "inference_used": { "const": false }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "x-canonical-resolution-precedence": [
    "NOT_APPLICABLE",
    "APPLICABLE_MISSING_EVIDENCE",
    "CONFLICTING_EVIDENCE",
    "EXPLICIT_EXCLUSION",
    "APPLICABLE_TRIGGERED",
    "APPLICABLE_VALID"
  ],
  "x-canonical-decisions": {
    "APPLICABLE_VALID": "PASS",
    "APPLICABLE_TRIGGERED": "FAIL",
    "APPLICABLE_MISSING_EVIDENCE": "INSUFFICIENT_EVIDENCE",
    "NOT_APPLICABLE": "NOT_APPLICABLE",
    "CONFLICTING_EVIDENCE": "POLICY_DEFINED",
    "EXPLICIT_EXCLUSION": "SUPPRESSED"
  },
  "x-canonical-finding-generated": {
    "APPLICABLE_VALID": false,
    "APPLICABLE_TRIGGERED": true,
    "APPLICABLE_MISSING_EVIDENCE": false,
    "NOT_APPLICABLE": false,
    "CONFLICTING_EVIDENCE": false,
    "EXPLICIT_EXCLUSION": false
  }
}
